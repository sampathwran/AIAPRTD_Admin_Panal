{
    "hosting":  {
                    "public":  "build/web",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "destination":  "/track.html",
                                         "source":  "/track"
                                     },
                                     {
                                         "destination":  "/index.html",
                                         "source":  "**"
                                     }
                                 ],
                    "headers":  [
                                    {
                                        "source":  "/**/index.html",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache, no-store, must-revalidate"
                                                        }
                                                    ]
                                    },
                                    {
                                        "source":  "/**/flutter_service_worker.js",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache, no-store, must-revalidate"
                                                        }
                                                    ]
                                    }
                                ]
                }
}
